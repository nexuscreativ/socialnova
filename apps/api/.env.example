# =============================================================================
# SocialNova API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# App
APP_NAME="SocialNova API"
APP_URL="http://localhost:3000"
API_URL="http://localhost:8000"
APP_ENV="development"
DEBUG=true

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/socialnova"

# Redis
REDIS_URL="redis://localhost:6379"

# OpenRouter (AI Gateway)
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Auth
SECRET_KEY="generate-a-strong-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (Payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@socialnova.com"

# CORS
CORS_ORIGINS='["http://localhost:3000"]'

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Security
ADMIN_EMAILS='["admin@socialnova.com"]'

# Logging
LOG_LEVEL="info"
LOG_FORMAT="text"

# Monitoring (optional)
SENTRY_DSN=""
PROMETHEUS_ENABLED=true
